{
  "name": "snapshot-voting-verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Recomputes a Snapshot proposal's result from the chain and tells the signers whether they may execute it",
  "scripts": {
    "verify": "ts-node --transpileOnly src/cli/verify.ts",
    "power": "ts-node --transpileOnly src/cli/power.ts",
    "eslint:check": "eslint --report-unused-disable-directives --cache --ext js,ts . --max-warnings 0",
    "eslint:fix": "pnpm run eslint:check --fix",
    "prettier:check": "prettier --check \"./**/*.{js,ts,json}\"",
    "prettier:fix": "prettier --write \"./**/*.{js,ts,json}\"",
    "test": "vitest run",
    "tsc": "tsc --project ."
  },
  "packageManager": "pnpm@10.34.4",
  "author": "API3",
  "devDependencies": {
    "@api3/eslint-plugin-commons": "3.0.0",
    "@types/node": "^25.3.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@api3/promise-utils": "^0.4.0",
    "viem": "^2.44.0",
    "zod": "^4.3.0"
  }
}
